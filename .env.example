# Copy this file to .env and adjust the paths for your machine.

LOCAL_RAG_ASSISTANT_CHROMA_DB_PATH=./data/chroma_db
LOCAL_RAG_ASSISTANT_CHROMA_COLLECTION_NAME=documents

# Point this to a local embedding GGUF file.
LOCAL_RAG_ASSISTANT_EMBEDDING_MODEL_PATH=./models/nomic-embed-text-v1.5.f32.gguf

# Point this to a local instruction/chat GGUF file.
LOCAL_RAG_ASSISTANT_LLM_MODEL_PATH=./models/gemma-3-1b-it-Q4_K_M.gguf

LOCAL_RAG_ASSISTANT_CHUNK_SIZE=512
LOCAL_RAG_ASSISTANT_CHUNK_OVERLAP=64
LOCAL_RAG_ASSISTANT_EMBEDDING_BATCH_SIZE=32
LOCAL_RAG_ASSISTANT_DEFAULT_TOP_K=5
LOCAL_RAG_ASSISTANT_EMBEDDING_DIM=768
